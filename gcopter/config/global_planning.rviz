Panels:
  - Class: rviz/Displays
    Name: Displays
    Help Height: 80
    Property Tree Widget:
      Expanded:
        - /GlobalMap1
        - /Baseline FIRI Mesh1
        - /HOM-MVIE Mesh1
      Splitter Ratio: 0.55
    Tree Height: 560
  - Class: rviz/Tool Properties
    Name: Tool Properties
    Expanded:
      - /2D Nav Goal1
    Splitter Ratio: 0.55
  - Class: rviz/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    Experimental: false
    SyncMode: 0
    SyncSource: GlobalMap
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Value: true
      Alpha: 1
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 50
      Color: 160; 160; 164
      Line Style:
        Value: Lines
        Line Width: 0.03
      Offset:
        X: 0
        Y: 0
        Z: 0
      Reference Frame: <Fixed Frame>
    - Class: rviz/Axes
      Name: Axes
      Enabled: true
      Value: true
      Length: 3
      Radius: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz/PointCloud2
      Name: GlobalMap
      Enabled: true
      Value: true
      Topic: /voxel_map
      Queue Size: 10
      Unreliable: true
      Selectable: false
      Style: Boxes
      Size (m): 0.25
      Size (Pixels): 3
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Channel Name: intensity
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Value: true
        Min Value: 0
        Max Value: 5
      Use Fixed Frame: true
      Use rainbow: true
      Invert Rainbow: false
      Min Color: 0; 0; 0
      Max Color: 255; 255; 255
      Color: 255; 255; 255
      Decay Time: 0
      Position Transformer: XYZ
    - Class: rviz/Marker
      Name: Route
      Enabled: true
      Value: true
      Marker Topic: /visualizer/route
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: Start Goal / Safety Sphere
      Enabled: true
      Value: true
      Marker Topic: /visualizer/spheres
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: Baseline FIRI Mesh
      Enabled: true
      Value: true
      Marker Topic: /visualizer/baseline_firi/mesh
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: Baseline FIRI Edge
      Enabled: true
      Value: true
      Marker Topic: /visualizer/baseline_firi/edge
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: Baseline FIRI Trajectory
      Enabled: true
      Value: true
      Marker Topic: /visualizer/baseline_firi/trajectory
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: HOM-MVIE Mesh
      Enabled: true
      Value: true
      Marker Topic: /visualizer/hom_mvie/mesh
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: HOM-MVIE Edge
      Enabled: true
      Value: true
      Marker Topic: /visualizer/hom_mvie/edge
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: HOM-MVIE Trajectory
      Enabled: true
      Value: true
      Marker Topic: /visualizer/hom_mvie/trajectory
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: Legacy Combined Mesh
      Enabled: false
      Value: false
      Marker Topic: /visualizer/mesh
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: Legacy Combined Edge
      Enabled: false
      Value: false
      Marker Topic: /visualizer/edge
      Queue Size: 100
      Namespaces: {}
    - Class: rviz/Marker
      Name: Legacy Combined Trajectory
      Enabled: false
      Value: false
      Marker Topic: /visualizer/trajectory
      Queue Size: 100
      Namespaces: {}
  Enabled: true
  Global Options:
    Background Color: 235; 235; 235
    Default Light: true
    Fixed Frame: odom
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
      Theta std deviation: 0.261799
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Target Frame: odom
      Distance: 62
      Pitch: 0.95
      Yaw: 2.67
      Focal Point:
        X: 0
        Y: 0
        Z: 2
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Field of View: 0.785398
      Near Clip Distance: 0.01
      Invert Z Axis: false
      Enable Stereo Rendering:
        Value: false
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
  Height: 1100
  Width: 1800
  X: 80
  Y: 60
