Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 170; 170; 170
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: kr_param_map
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.03
      Style: Flat Squares
      Topic: /voxel_map
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Local Corridors
      Queue Size: 100
      Topic: /firi_benchmark/local_corridors
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Full Corridors
      Queue Size: 100
      Topic: /firi_benchmark/full_corridors
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 45
      Focal Point:
        X: 0
        Y: 0
        Z: 2
      Pitch: 0.6
      Target Frame: map
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
