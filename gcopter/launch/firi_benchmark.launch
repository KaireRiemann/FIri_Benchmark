<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="density_label" default="medium"/>
  <arg name="map_seed" default="1024"/>
  <arg name="master_seed" default="20260622"/>
  <arg name="output_dir" default="/tmp/firi_benchmark"/>
  <arg name="benchmark_mode" default="all"/>
  <arg name="run_id" default=""/>

  <arg name="resolution" default="0.25"/>
  <arg name="map_size_x" default="50.0"/>
  <arg name="map_size_y" default="50.0"/>
  <arg name="map_size_z" default="8.0"/>
  <arg name="map_x_origin" default="-25.0"/>
  <arg name="map_y_origin" default="-25.0"/>
  <arg name="map_z_origin" default="0.0"/>
  <arg name="map_frame_id" default="map"/>

  <arg name="cylinder_ratio" default="0.06"/>
  <arg name="circle_ratio" default="0.00"/>
  <arg name="gate_ratio" default="0.00"/>
  <arg name="ellip_ratio" default="0.00"/>
  <arg name="poly_ratio" default="0.006"/>
  <arg name="w1" default="0.10"/>
  <arg name="w2" default="0.50"/>
  <arg name="w3" default="2.00"/>

  <arg name="point_seed_count" default="50"/>
  <arg name="line_seed_count_per_length" default="50"/>
  <arg name="planning_case_count" default="20"/>
  <arg name="repeats" default="5"/>
  <arg name="warmup_repeats" default="1"/>
  <arg name="enable_visualization" default="false"/>
  <arg name="rviz" default="false"/>

  <node pkg="param_env" type="structure_map" name="structure_map" output="screen">
    <remap from="~global_cloud" to="/voxel_map"/>
    <param name="map/x_size" value="$(arg map_size_x)"/>
    <param name="map/y_size" value="$(arg map_size_y)"/>
    <param name="map/z_size" value="$(arg map_size_z)"/>
    <param name="map/x_origin" value="$(arg map_x_origin)"/>
    <param name="map/y_origin" value="$(arg map_y_origin)"/>
    <param name="map/z_origin" value="$(arg map_z_origin)"/>
    <param name="map/resolution" value="$(arg resolution)"/>
    <param name="map/inflate_radius" value="0.0"/>
    <param name="map/frame_id" value="$(arg map_frame_id)"/>
    <param name="map/auto_change" value="false"/>
    <param name="map/simple_2d" value="false"/>
    <param name="params/cylinder_ratio" value="$(arg cylinder_ratio)" type="double"/>
    <param name="params/circle_ratio" value="$(arg circle_ratio)" type="double"/>
    <param name="params/gate_ratio" value="$(arg gate_ratio)" type="double"/>
    <param name="params/ellip_ratio" value="$(arg ellip_ratio)" type="double"/>
    <param name="params/poly_ratio" value="$(arg poly_ratio)" type="double"/>
    <param name="params/w1" value="$(arg w1)"/>
    <param name="params/w2" value="$(arg w2)"/>
    <param name="params/w3" value="$(arg w3)"/>
    <param name="params/add_noise" value="false"/>
    <param name="params/seed" value="$(arg map_seed)"/>
    <param name="clear_path" value="$(find param_env)/clear_pos/clear_3d.csv"/>
    <param name="clear_pos" value="false"/>
    <param name="dataset/save_map" value="false"/>
    <param name="dataset/samples_num" value="0"/>
    <param name="dataset/start_index" value="0"/>
    <param name="dataset/path" value="$(arg output_dir)/param_env_dataset"/>
    <param name="dyn/dyn_mode" value="false"/>
    <param name="dyn/dt" value="10.0"/>
  </node>

  <node pkg="gcopter" type="firi_benchmark_node" name="firi_benchmark_node" output="screen" required="true">
    <rosparam file="$(find gcopter)/config/firi_benchmark.yaml" command="load"/>
    <param name="MapTopic" value="/voxel_map"/>
    <param name="OutputDir" value="$(arg output_dir)"/>
    <param name="RunId" value="$(arg run_id)"/>
    <param name="DensityLabel" value="$(arg density_label)"/>
    <param name="BenchmarkMode" value="$(arg benchmark_mode)"/>
    <param name="MapSeed" value="$(arg map_seed)"/>
    <param name="MasterSeed" value="$(arg master_seed)"/>
    <param name="VoxelWidth" value="$(arg resolution)"/>
    <param name="MapOriginX" value="$(arg map_x_origin)"/>
    <param name="MapOriginY" value="$(arg map_y_origin)"/>
    <param name="MapOriginZ" value="$(arg map_z_origin)"/>
    <param name="MapSizeX" value="$(arg map_size_x)"/>
    <param name="MapSizeY" value="$(arg map_size_y)"/>
    <param name="MapSizeZ" value="$(arg map_size_z)"/>
    <param name="PointSeedCount" value="$(arg point_seed_count)"/>
    <param name="LineSeedCountPerLength" value="$(arg line_seed_count_per_length)"/>
    <param name="PlanningCaseCount" value="$(arg planning_case_count)"/>
    <param name="Repeats" value="$(arg repeats)"/>
    <param name="WarmupRepeats" value="$(arg warmup_repeats)"/>
    <param name="EnableVisualization" value="$(arg enable_visualization)"/>
    <param name="VisualizationFrameId" value="$(arg map_frame_id)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find gcopter)/config/firi_benchmark.rviz"/>
</launch>
